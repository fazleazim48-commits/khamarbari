# MongoDB Atlas Connection URI
# Example format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/khamarbari?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/khamarbari?retryWrites=true&w=majority

# Database name (default: khamarbari)
MONGODB_DB_NAME=khamarbari
